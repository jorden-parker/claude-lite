{
  "bashOutputMaxChars": 15000,
  "promptSuggestionEnabled": false,
  "skillListingMaxDescChars": 300,
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "gh *",
      "git push *",
      "git --no-optional-locks status *",
      "git diff *",
      "git log *",
      "git rev-parse *",
      "open /tmp/claude-skills/*",
      "open /private/tmp/claude-skills/*"
    ],
    "network": {
      "allowedDomains": [
        "127.0.0.1",
        "[::1]",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "pypi.org",
        "files.pythonhosted.org",
        "context7.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": ["~/.cache/claude-sandbox", "/tmp/claude-skills", "/private/tmp/claude-skills"],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.config/context7",
        "~/.npmrc",
        "~/Library/Keychains"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "SHORTCUT_API_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "DISABLE_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "npm_config_fund": "false",
    "npm_config_update_notifier": "false",
    "npm_config_progress": "false",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "permissions": {
    "additionalDirectories": ["/tmp/claude-skills", "/private/tmp/claude-skills"],
    "allow": ["Bash(open /tmp/claude-skills/*)", "Bash(open /private/tmp/claude-skills/*)"],
    "deny": [
      "Read(./dist/**)",
      "Read(**/.next/**)",
      "Read(**/coverage/**)",
      "Read(**/*.min.js)",
      "Read(**/*.map)",
      "Artifact",
      "CronCreate",
      "CronDelete",
      "CronList",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ScheduleWakeup",
      "SendFeedback",
      "SendUserFile",
      "ShareOnboardingGuide",
      "Workflow"
    ],
    "ask": ["Bash(dangerouslyDisableSandbox:true)", "Bash(gh *)", "Bash(git push *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook bash-guard"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook read-guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook edit-check"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook tdd-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook bash-trim"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook tdd-guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook edit-check"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook tdd-guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook fallow-stop"
          }
        ]
      }
    ]
  }
}
