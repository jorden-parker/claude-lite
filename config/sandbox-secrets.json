{
  "denyRead": [
    "~/.ssh",
    "~/.aws",
    "~/.config/gh",
    "~/.config/context7",
    "~/.npmrc",
    "~/Library/Keychains",
    "~/.gnupg",
    "~/.netrc",
    "~/.docker/config.json",
    "~/.kube/config",
    "~/.config/gcloud"
  ],
  "envVars": [
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "SHORTCUT_API_TOKEN",
    "NPM_TOKEN",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "OPENAI_API_KEY"
  ]
}
