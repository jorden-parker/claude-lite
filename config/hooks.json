{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        { "type": "command", "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook bash-guard" }
      ]
    },
    {
      "matcher": "Read",
      "hooks": [
        { "type": "command", "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook read-guard" }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        { "type": "command", "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook edit-check" },
        { "type": "command", "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook tdd-guard" }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        { "type": "command", "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook bash-trim" },
        { "type": "command", "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook tdd-guard" }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        { "type": "command", "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook edit-check" },
        { "type": "command", "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook tdd-guard" },
        { "type": "command", "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook fallow-stop" }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        { "type": "command", "command": "\"$CLAUDE_LITE_HOME\"/dist/claude-lite hook fallow-stop" }
      ]
    }
  ]
}
