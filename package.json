  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "1.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^5.0.0"
  }
}
