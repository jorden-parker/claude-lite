{
  "name": "claude-lite",
  "version": "0.1.0",
  "bin": {
    "claude-lite": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "test": "bun test",
    "build": "bun build --compile src/cli.ts --outfile dist/claude-lite && rm -f .*.bun-build",
    "lint": "oxlint . && oxfmt --check .",
    "prepare": "husky",
    "format": "oxfmt .",
    "typecheck": "tsc",
    "report:styles": "tailwindcss -i src/report-ui/theme.css -o src/report-ui/utilities.css --minify && oxfmt src/report-ui/utilities.css"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.82.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.0.0"
  }
}
