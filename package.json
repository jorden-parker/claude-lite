{
  "name": "claude-lite",
  "version": "0.1.0",
  "bin": {
    "claude-lite": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "test": "bun test",
    "build": "bun build --compile src/cli.ts --outfile dist/claude-lite && rm -f .*.bun-build",
